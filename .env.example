# NanoClaw Environment Configuration
# Copy this file to .env and fill in your values

# Anthropic API Key (required)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Container Runtime (docker or apple-container)
CONTAINER_RUNTIME=docker

# Node Environment
NODE_ENV=production

# Timezone
TZ=UTC

# WhatsApp Configuration (optional)
# Leave empty for interactive QR code authentication
WHATSAPP_PHONE_NUMBER=

# Logging Level (optional)
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Database Configuration (optional)
DB_PATH=/app/data/nanoclaw.db

# Agent Container Configuration (optional)
AGENT_IMAGE=nanoclaw-agent:latest
