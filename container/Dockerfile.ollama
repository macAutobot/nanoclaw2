# NanoClaw Agent Container (Ollama Version)
# Runs local Ollama models instead of Claude Agent SDK

FROM node:22-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Copy package files
COPY agent-runner/package*.json ./

# Install all dependencies (needed for TypeScript build)
RUN npm install

# Copy source code
COPY agent-runner/ ./

# Build TypeScript (only the Ollama version)
RUN npx tsc src/index-ollama.ts --outDir dist --module NodeNext --target ES2022 --moduleResolution NodeNext --esModuleInterop --skipLibCheck

# Remove dev dependencies to reduce image size
RUN npm prune --production

# Create workspace directories
RUN mkdir -p /workspace/group /workspace/global /workspace/extra /workspace/ipc/messages /workspace/ipc/tasks /workspace/ipc/input

# Create entrypoint script for Ollama version
RUN printf '#!/bin/bash\nset -e\n[ -f /workspace/env-dir/env ] && export $(cat /workspace/env-dir/env | xargs)\ncat > /tmp/input.json\nnode /app/dist/index-ollama.js < /tmp/input.json\n' > /app/entrypoint.sh && chmod +x /app/entrypoint.sh

# Set ownership to node user (non-root)
RUN chown -R node:node /workspace /app

# Switch to non-root user
USER node

# Set working directory to group workspace
WORKDIR /workspace/group

# Environment variables for Ollama
ENV OLLAMA_MODEL=qwen2.5-coder:14b
ENV OLLAMA_HOST=http://host.docker.internal:11434

# Entry point reads JSON from stdin, outputs JSON to stdout
ENTRYPOINT ["/app/entrypoint.sh"]
